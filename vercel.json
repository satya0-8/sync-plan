{
  "version": 2,
  "rewrites": [
    { "source": "/plan/:slug", "destination": "/plan.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js?path=/api/$1" },
    { "source": "/mcp", "destination": "/api/index.js?path=/mcp" },
    { "source": "/sse", "destination": "/api/index.js?path=/sse" }
  ]
}
